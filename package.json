{
  "name": "pi-unsloth",
  "version": "0.1.0",
  "description": "Pi extension that turns a local Unsloth Studio server into a first-class Pi provider",
  "license": "MIT",
  "homepage": "https://github.com/TheLoomLabs/pi-unsloth#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheLoomLabs/pi-unsloth.git"
  },
  "bugs": {
    "url": "https://github.com/TheLoomLabs/pi-unsloth/issues"
  },
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "unsloth",
    "llama.cpp",
    "local-llm"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "extensions",
    "src",
    "skills",
    "CONTRIBUTING.md",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\"",
    "check": "npm run typecheck && npm test"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
